{
  "name": "di-rap-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-index.mjs",
    "dev": "vite",
    "build": "node scripts/build-index.mjs && tsc -p tsconfig.json && vite build && node scripts/inline-index.mjs && node scripts/strip-fan.mjs",
    "test": "vitest run",
    "refresh-films": "node --env-file-if-exists=.env --experimental-strip-types scripts/refresh-films.ts",
    "typecheck": "tsc -p tsconfig.json",
    "demo": "node scripts/demo-3d.mjs demo"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "meshoptimizer": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  },
  "dependencies": {
    "@vercel/og": "0.11.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  }
